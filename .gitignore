# Local environment and Python caches
.venv/
__pycache__/
*.py[cod]

# Live configuration / secrets (the safe example stays tracked)
/config/config.toml
.env
.env.*

# Dedicated user media and generated results; preserve directory placeholders
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep

# Legacy media and transcripts can still live elsewhere; never commit them
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.mp4
*.mkv
*.mov
*.avi
*.webm
timecode-*.txt
simple-*.txt
*.blocks.txt
*.srt
*.tmp
